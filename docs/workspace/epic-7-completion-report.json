      "file": ".github/workflows/deploy.yml",
      "triggers": ["push to main", "workflow_dispatch"],
      "nodeVersion": "20",
      "jobs": ["build", "deploy"],
      "permissions": ["contents: read", "pages: write", "id-token: write"],
      "actions": [
        "actions/checkout@v4",
        "actions/setup-node@v4",
        "actions/upload-pages-artifact@v3",
        "actions/deploy-pages@v4"
      ]
    },
